{
  "name": "brgl/grid-list-buttons",
  "d4Shortcode": "et_pb_brgridlist",
  "title": "BeRocket Grid/List View",
  "titles": "BeRocket Grid/List Views",
  "category": "module",
  "moduleClassName": "et_pb_brgridlist",
  "moduleOrderClassName": "et_pb_brgridlist",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "settings": {
        "advanced": { "html": {} },
        "meta": { "adminLabel": {} },
        "decoration": { "layout": {}, "disabledOn": {} }
      }
    },
    "title": {
      "type": "object",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupName": "contentOptions",
            "groupSlug": "contentOptions",
            "priority": 10,
            "render": true,
            "attrName": "title.innerContent",
            "label": "Title",
            "component": { "name": "divi/text", "type": "field" }
          }
        }
      }
    },
    "all_page": {
      "type": "object",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupName": "contentOptions",
            "groupSlug": "contentOptions",
            "priority": 20,
            "render": true,
            "attrName": "all_page.innerContent",
            "label": "Show on all pages",
            "component": { "name": "divi/toggle", "type": "field" }
          }
        }
      }
    },
    "position": {
      "type": "object",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupName": "contentOptions",
            "groupSlug": "contentOptions",
            "priority": 30,
            "render": true,
            "attrName": "position.innerContent",
            "label": "Position",
            "component": {
              "name": "divi/select",
              "type": "field",
              "props": {
                "options": {
                  "": { "label": "None" },
                  "left": { "label": "Left" },
                  "right": { "label": "Right" }
                }
              }
            }
          }
        }
      }
    },
    "buttons": {
      "type": "object",
      "settings": {
        "decoration": {
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designButtons",
              "attrName": "buttons.decoration.font",
              "priority": 10,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/font",
                "props": {
                  "grouped": true,
                  "fieldLabel": "Buttons",
                  "fields": {
                    "family": { "render": false },
                    "weight": { "render": false },
                    "style": { "render": false },
                    "letterSpacing": { "render": false },
                    "lineHeight": { "render": false }
                  }
                }
              }
            }
          },
          "spacing": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designButtons",
              "attrName": "buttons.decoration.spacing",
              "priority": 20,
              "render": true,
              "component": {
                "type": "group",
                "name": "divi/spacing",
                "props": {
                  "grouped": true,
                  "fieldLabel": "Buttons",
                  "fields": {
                    "margin": { "render": false }
                  }
                }
              }
            }
          }
        }
      },
      "styleProps": {
        "font": {
          "selector": "{{selector}} .berocket_lgv_widget",
          "important": true
        },
        "spacing": {
          "selector": "{{selector}} .berocket_lgv_widget",
          "important": true
        }
      }
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentOptions": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentOptions",
        "multiElements": true,
        "component": { "name": "divi/composite", "props": { "groupLabel": "Content" } }
      },
      "designButtons": {
        "panel": "design",
        "priority": 10,
        "groupName": "designButtons",
        "component": { "name": "divi/composite", "props": { "groupLabel": "Buttons" } }
      }
    }
  },
  "defaultAttrs": {
    "title": { "innerContent": { "desktop": { "value": "" } } },
    "all_page": { "innerContent": { "desktop": { "value": "on" } } },
    "position": { "innerContent": { "desktop": { "value": "" } } }
  }
}
